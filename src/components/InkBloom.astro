---
/**
 * The page transition: ink washes across the viewport from wherever you
 * clicked, covers it, and recedes to reveal the new page.
 *
 * The wash itself is a masked <div>; its parent carries an feTurbulence /
 * feDisplacementMap filter, so the growing mask edge is displaced into
 * something irregular rather than a clean circle. Mask growth is a single
 * animated custom property — no per-frame JavaScript.
 *
 * `transition:persist` keeps this element (and its running animation) alive
 * across the swap.
 */
---

<div class="ink-bloom" data-state="idle" aria-hidden="true" transition:persist="ink-bloom">
  <div class="ink-bloom__filtered">
    <div class="ink-bloom__wash"></div>
  </div>
</div>

<script>
  const ROOT_ATTR = 'data-ink-bloom-ready';

  // ClientRouter may re-run this module; the listeners belong to the document.
  if (
    !document.documentElement.hasAttribute(ROOT_ATTR) &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    document.documentElement.setAttribute(ROOT_ATTR, '');

    const WASH_IN = 540;
    /** How far the wash starts from where you clicked, vs. the middle of the page. */
    const ORIGIN_PULL = 0.3;
    const bloom = () => document.querySelector<HTMLElement>('.ink-bloom');

    /** Re-roll the turbulence so no two transitions share an edge. */
    function reseed() {
      const turbulence = document.querySelector('#ink-wash-turbulence');
      turbulence?.setAttribute('seed', String(Math.floor(Math.random() * 400)));
    }

    /**
     * Start the wash from the thing that was clicked, pulled part of the way
     * back to the middle so a corner link still covers the far corner.
     */
    function setOrigin(el: Element | undefined, node: HTMLElement) {
      let x = 50;
      let y = 46;
      if (el instanceof Element) {
        const rect = el.getBoundingClientRect();
        if (rect.width || rect.height) {
          const cx = ((rect.left + rect.width / 2) / window.innerWidth) * 100;
          const cy = ((rect.top + rect.height / 2) / window.innerHeight) * 100;
          x = 50 + (cx - 50) * ORIGIN_PULL;
          y = 50 + (cy - 50) * ORIGIN_PULL;
        }
      }
      node.style.setProperty('--bloom-x', `${x.toFixed(2)}%`);
      node.style.setProperty('--bloom-y', `${y.toFixed(2)}%`);
    }

    function run(node: HTMLElement, state: 'in' | 'out') {
      node.setAttribute('data-state', 'idle');
      // Force a frame so the animation restarts cleanly on rapid navigation.
      void node.offsetWidth;
      node.setAttribute('data-state', state);
    }

    document.addEventListener('astro:before-preparation', (event) => {
      const node = bloom();
      if (!node) return;
      const prepare = event as typeof event & {
        loader: () => Promise<void>;
        sourceElement?: Element;
      };
      const load = prepare.loader;

      prepare.loader = async () => {
        reseed();
        setOrigin(prepare.sourceElement, node);
        run(node, 'in');
        // Hold the swap until the page is covered, so it is never seen.
        await Promise.all([
          load(),
          new Promise((resolve) => setTimeout(resolve, WASH_IN)),
        ]);
      };
    });

    document.addEventListener('astro:after-swap', () => {
      const node = bloom();
      if (!node || node.getAttribute('data-state') !== 'in') return;
      run(node, 'out');
    });

    // Tidy up once the ink has dried.
    document.addEventListener('animationend', (event) => {
      const node = event.target as HTMLElement;
      if (node?.classList?.contains('ink-bloom') && node.dataset.state === 'out') {
        node.setAttribute('data-state', 'idle');
      }
    });
  }
</script>
