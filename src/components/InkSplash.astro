---
/**
 * Page transition: splash to cover, then fade the next page in.
 *
 * The film is CodyHouse's 25-frame PNG sequence (MIT), recolored to the
 * site ink. CSS `steps(24)` plays the drop like a flipbook. The last
 * frame holds; we never play the sprite backwards. The cover fades and
 * the incoming page fades up underneath.
 *
 * `transition:persist` keeps the overlay alive across the swap so the
 * cover never lifts early.
 *
 * License: https://codyhouse.co/mit
 */
import { url } from '../lib/url';

const sprite = url('/ink-splash.png');
---

<div
  class="ink-splash"
  data-state="idle"
  aria-hidden="true"
  transition:persist="ink-splash"
  style={`--splash-src: url('${sprite}')`}
>
  <div class="ink-splash__drop">
    <div class="ink-splash__film"></div>
  </div>
</div>

<script>
  const ROOT_ATTR = 'data-ink-splash-ready';

  // One set of listeners for the document, even if ClientRouter re-runs this.
  if (
    !document.documentElement.hasAttribute(ROOT_ATTR) &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    document.documentElement.setAttribute(ROOT_ATTR, '');

    /** Matches `--dur-splash-in`. The last frame is a solid cover. */
    const WASH_IN = 800;
    const splash = () => document.querySelector<HTMLElement>('.ink-splash');

    let lastX = 50;
    let lastY = 50;

    /** A new landing: place, flip, and turn — then scale so the last frame still covers. */
    function scatter(node: HTMLElement) {
      let x = 18 + Math.random() * 64;
      let y = 18 + Math.random() * 64;
      // Don't land too near the last drop; it reads as the same splash.
      if (Math.hypot(x - lastX, y - lastY) < 22) {
        x = Math.min(82, Math.max(18, 100 - x));
        y = Math.min(82, Math.max(18, y > 50 ? y - 28 : y + 28));
      }
      lastX = x;
      lastY = y;

      const flipX = Math.random() < 0.5 ? -1 : 1;
      const flipY = Math.random() < 0.5 ? -1 : 1;
      const rot = Math.round(Math.random() * 32 - 16);
      const offset = Math.max(Math.abs(x / 100 - 0.5), Math.abs(y / 100 - 0.5));
      const turn = (Math.abs(rot) * Math.PI) / 180;
      const rotPad = Math.abs(Math.cos(turn)) + Math.abs(Math.sin(turn));
      const reach = (1.14 + 2.5 * offset) * Math.max(1.1, rotPad);

      node.style.setProperty('--splash-x', `${x.toFixed(1)}%`);
      node.style.setProperty('--splash-y', `${y.toFixed(1)}%`);
      node.style.setProperty('--splash-rot', `${rot}deg`);
      node.style.setProperty('--splash-flip-x', String(flipX));
      node.style.setProperty('--splash-flip-y', String(flipY));
      node.style.setProperty('--splash-scale', reach.toFixed(3));
    }

    function run(node: HTMLElement, state: 'in' | 'fade') {
      if (node.dataset.state === state) {
        node.setAttribute('data-state', 'idle');
        void node.offsetWidth;
      }
      node.setAttribute('data-state', state);
    }

    document.addEventListener('astro:before-preparation', (event) => {
      const node = splash();
      if (!node) return;
      const prepare = event as typeof event & { loader: () => Promise<void> };
      const load = prepare.loader;

      prepare.loader = async () => {
        scatter(node);
        run(node, 'in');
        // Hold the swap until the drop has covered the page.
        await Promise.all([
          load(),
          new Promise((resolve) => setTimeout(resolve, WASH_IN)),
        ]);
      };
    });

    document.addEventListener('astro:before-swap', (event) => {
      const next = (event as Event & { newDocument?: Document }).newDocument;
      // First paint of the incoming page is invisible; it fades in after the swap.
      next?.documentElement.classList.add('is-page-pending');
    });

    document.addEventListener('astro:after-swap', () => {
      const node = splash();
      if (node?.getAttribute('data-state') === 'in') run(node, 'fade');
      requestAnimationFrame(() => {
        document.documentElement.classList.add('is-page-arrive');
      });
    });

    document.addEventListener('animationend', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (!target.classList.contains('ink-splash')) return;
      if (target.dataset.state !== 'fade') return;
      target.setAttribute('data-state', 'idle');
      document.documentElement.classList.remove('is-page-pending', 'is-page-arrive');
    });
  }
</script>
