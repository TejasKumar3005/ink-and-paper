---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import InkDivider from '../../components/InkDivider.astro';
import {
  formatDate,
  getArticles,
  isoDate,
  readingTime,
  type WritingEntry,
} from '../../lib/content';

interface Props {
  entry: WritingEntry;
  previous: WritingEntry | null;
  next: WritingEntry | null;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const articles = await getArticles();
  return articles.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      previous: articles[index + 1] ?? null,
      next: articles[index - 1] ?? null,
    },
  }));
};

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const minutes = readingTime(entry.body);
---

<Base
  title={entry.data.title ?? 'Writing'}
  description={entry.data.description}
  type="article"
  publishedTime={entry.data.date}
>
  <article class="shell shell--narrow page-top page-bottom">
    <header class="article__header">
      <p class="meta">
        <a href="/writing/">Writing</a>
      </p>
      <h1 class="article__title">{entry.data.title}</h1>
      <ul class="article__meta meta" role="list">
        <li>
          <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
        </li>
        <li>{minutes} min read</li>
      </ul>
    </header>

    <div class="prose prose--dropcap" data-reveal>
      <Content />
    </div>

    <InkDivider />

    <nav class="article__footer meta meta--plain" aria-label="More writing">
      {
        previous ? (
          <a class="ink-link" rel="prev" href={`/writing/${previous.id}/`}>
            ← {previous.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="ink-link" rel="next" href={`/writing/${next.id}/`}>
            {next.data.title} →
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .article__header {
    padding-block: var(--space-l) var(--space-xl);
  }

  .prose {
    margin-block-start: var(--space-l);
  }
</style>
