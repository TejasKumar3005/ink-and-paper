---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EssayEntry from '../../components/EssayEntry.astro';
import { site } from '../../site.config';
import { formatDate, getWriting, isoDate } from '../../lib/content';

const entries = await getWriting();

/** Thoughts are short enough to render inline; articles get a line and a note. */
const stream = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: entry.data.kind === 'thought' ? (await render(entry)).Content : null,
  })),
);
---

<Base
  title="Writing"
  description={`Essays and shorter notes by ${site.name}, newest first.`}
>
  <div class="folio page-bottom">
    <header class="writing__head">
      <h1 class="title">Writing</h1>
      <p class="subtitle">Essays, newest first.</p>
    </header>

    <div class="folio__wide">
      {
        stream.map(({ entry, Content }, index) =>
          entry.data.kind === 'article' ? (
            <EssayEntry entry={entry} note={index + 1} />
          ) : (
            <div class="entry" id={entry.id} data-reveal>
              <div class="entry__text justify">{Content && <Content />}</div>
              <aside class="sidenote">
                <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
              </aside>
            </div>
          ),
        )
      }
    </div>
  </div>
</Base>

<style>
  .writing__head {
    margin-block-end: var(--space-xl);
  }
</style>
