---
import Base from '../layouts/Base.astro';
import InkHeading from '../components/InkHeading.astro';
import { site } from '../site.config';
---

<Base title="Contact" description={`How to reach ${site.name}.`}>
  <div class="shell shell--narrow page-top page-bottom contact">
    <InkHeading as="h1">Contact</InkHeading>

    <p class="contact__note">{site.contactNote}</p>

    <a class="ink-link contact__email" href={`mailto:${site.email}`} data-reveal>
      {site.email}
    </a>

    <ul class="link-list" role="list" data-reveal style="--reveal-delay:120ms">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              <span>{link.label}</span>
              {link.handle && <span class="meta">{link.handle}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .contact {
    padding-block-start: var(--space-l);
  }
</style>
