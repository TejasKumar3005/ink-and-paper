---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EssayEntry from '../components/EssayEntry.astro';
import { site } from '../site.config';
import { url } from '../lib/url';
import { getArticles, getStory } from '../lib/content';

const [articles, story] = await Promise.all([getArticles(), getStory()]);

/** A photograph of me, if one is dropped in at src/assets/portrait.(jpg|png|webp). */
const [headshot] = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', {
    eager: true,
  }),
).map((module) => module.default);
---

<Base title={site.name} description={site.description}>
  <div class="folio page-bottom home">
    {
      headshot && (
        <figure class="folio__margin margin-figure">
          <Image
            src={headshot}
            alt={`${site.name}, smiling, in a grey turtleneck on a hillside with cloud and pine forest behind`}
            widths={[120, 240, 360]}
            sizes="7rem"
            loading="eager"
            fetchpriority="high"
            quality={80}
          />
        </figure>
      )
    }

    <header class="home__head">
      <h1 class="title">{site.name}</h1>
      <p class="subtitle">{site.intro.role}</p>
    </header>

    {
      site.intro.body.map((paragraph, index) => (
        <p class:list={['home__intro', 'justify', index === 0 && 'dropcap']}>{paragraph}</p>
      ))
    }

    <h2 class="section-label" id="writing">Writing</h2>
    <div class="folio__wide">
      {articles.map((entry, index) => <EssayEntry entry={entry} note={index + 1} />)}
    </div>

    <h2 class="section-label" id="story">Story lane</h2>
    <ul class="fleurons">
      {
        story.map((entry) => (
          <li>
            <a href={url(`/story/#${entry.id}`)}>{entry.data.title}</a>
            <span class="meta"> ({entry.data.date.getUTCFullYear()})</span>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .home__head {
    margin-block-end: var(--space-m);
  }

  .home__intro + .home__intro {
    margin-block-start: 0.85em;
  }
</style>
