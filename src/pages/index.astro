---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import InkHeading from '../components/InkHeading.astro';
import InkDivider from '../components/InkDivider.astro';
import { site } from '../site.config';
import { url } from '../lib/url';
import { formatDate, getArticles, getStory, isoDate, readingTime } from '../lib/content';

const [articles, story] = await Promise.all([getArticles(), getStory()]);
const latest = articles[0];
const firstPhoto = story[0];
const portrait =
  story.find((entry) => entry.id === site.intro.portrait) ?? story[story.length - 1];

/** A photograph of me, if one is dropped in at src/assets/portrait.(jpg|png|webp). */
const [headshot] = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', {
    eager: true,
  }),
).map((module) => module.default);

/** The intro lede marks one word with {braces}; that word gets the accent. */
const [before, accent = '', after = ''] = site.intro.lede.split(/\{(.+?)\}/);
---

<Base title={site.name} description={site.description}>
  <div class="shell page-top home">
    <section class="intro" aria-labelledby="intro-heading">
      <div class="intro__text">
        <h1 id="intro-heading" class="lede">
          {before}<span class="accent">{accent}</span>{after}
        </h1>

        <div class="intro__body" data-reveal style="--reveal-delay:180ms">
          {site.intro.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="now" data-reveal style="--reveal-delay:300ms">
          <p class="meta">
            {site.intro.now.label} — {site.intro.now.updated}
          </p>
          <p class="now__text">{site.intro.now.text}</p>
        </div>
      </div>

      {
        headshot ? (
          <figure class="print print--portrait" data-develop>
            <span class="print__frame">
              <Image
                src={headshot}
                alt={`${site.name}, smiling, in a grey turtleneck on a hillside with cloud and pine forest behind`}
                widths={[360, 540, 720]}
                sizes="(min-width: 56rem) 20rem, 70vw"
                loading="eager"
                fetchpriority="high"
                quality={78}
              />
            </span>
            <figcaption class="print__caption">{site.name}</figcaption>
          </figure>
        ) : portrait && (
          <a
            class="print"
            href={url(`/story/#${portrait.id}`)}
            data-develop
            aria-label={`From the story lane: ${portrait.data.title}`}
          >
            <Image
              src={portrait.data.image}
              alt={portrait.data.alt}
              widths={[360, 540, 720]}
              sizes="(min-width: 56rem) 22rem, 70vw"
              loading="eager"
              fetchpriority="high"
              quality={72}
            />
            <span class="print__caption">{portrait.data.title}</span>
          </a>
        )
      }
    </section>

    <section class="themes" aria-labelledby="themes-heading">
      <h2 id="themes-heading" class="meta themes__label">What I keep returning to</h2>
      <ol class="themes__list" role="list">
        {
          site.intro.themes.map((theme, index) => (
            <li data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <span class="meta themes__num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="themes__title">{theme.title}</h3>
              <p class="themes__text">{theme.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <InkDivider />

    <section aria-labelledby="onward-heading">
      <InkHeading as="h2" id="onward-heading" class="section-label">Start here</InkHeading>

      <div class="onward">
        {
          latest && (
            <a class="onward__item" href={url(`/writing/${latest.id}/`)} data-reveal>
              {latest.data.cover && (
                <span class="onward__media">
                  <Image
                    src={latest.data.cover}
                    alt=""
                    widths={[420, 680, 900]}
                    sizes="(min-width: 56rem) 30rem, 100vw"
                    quality={72}
                  />
                </span>
              )}
              <span class="meta">
                Latest essay ·{' '}
                <time datetime={isoDate(latest.data.date)}>
                  {formatDate(latest.data.date)}
                </time>{' '}
                · {readingTime(latest.body)} min
              </span>
              <h3 class="onward__title">{latest.data.title}</h3>
              <p class="onward__blurb">{latest.data.description}</p>
              <span class="ink-link onward__more meta meta--plain">Read the essay</span>
            </a>
          )
        }

        {
          firstPhoto && (
            <a
              class="onward__item"
              href={url('/story/')}
              data-reveal
              style="--reveal-delay:140ms"
            >
              <span class="onward__media">
                <Image
                  src={firstPhoto.data.image}
                  alt=""
                  widths={[420, 680, 900]}
                  sizes="(min-width: 56rem) 30rem, 100vw"
                  quality={72}
                />
              </span>
              <span class="meta">Story lane · {story.length} photographs</span>
              <h3 class="onward__title">{firstPhoto.data.title}, and what came after</h3>
              <p class="onward__blurb">
                Pictures from the way here, one at a time, each with the reason it
                matters beside it.
              </p>
              <span class="ink-link onward__more meta meta--plain">Walk the lane</span>
            </a>
          )
        }
      </div>

      <p class="onward__all" data-reveal style="--reveal-delay:240ms">
        <a class="ink-link" href={url('/writing/')}>All writing</a>
        <span class="onward__sep" aria-hidden="true">·</span>
        <a class="ink-link" href={url('/contact/')}>Write to me</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-l) var(--space-xl);
  }

  .intro__body,
  .now {
    margin-block-start: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-2xl);
      align-items: center;
      padding-block: var(--space-l) var(--space-xl);
    }

    .intro__body,
    .now {
      margin-block-start: var(--space-l);
    }
  }

  .onward__all {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
  }

  .onward__sep {
    color: var(--rule-strong);
  }
</style>
