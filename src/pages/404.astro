---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Not found" description="That page is not here.">
  <div class="folio page-bottom">
    <h1 class="title">Not here</h1>
    <p class="subtitle">This page doesn't exist.</p>
    <p class="notfound__home"><a href={url('/')}>Go home</a></p>
  </div>
</Base>

<style>
  .notfound__home {
    margin-block-start: var(--space-l);
  }
</style>
